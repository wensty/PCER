<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Web.Extensions" />
    <EmbeddedResource Include="Localization/zh-CN.json" />
    <Reference Include="Mono.Cecil">
      <HintPath>$(PotionCraftPath)\BepInEx\core\Mono.Cecil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateGameReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(PotionCraftPath)' == ''" Text="Set the PotionCraftPath environment variable or MSBuild property to the game directory." />
    <Error Condition="'$(PotionCraftPath)' != '' and !Exists('$(PotionCraftPath)\BepInEx\core\Mono.Cecil.dll')" Text="Mono.Cecil.dll was not found under PotionCraftPath/BepInEx/core. Check PotionCraftPath and the BepInEx installation." />
  </Target>
</Project>
